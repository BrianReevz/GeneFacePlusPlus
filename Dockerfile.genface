
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Set environment variables to ensure the CUDA toolkit is found by compilers.
# This is crucial for building Python packages with C++/CUDA extensions.
ENV PATH="/usr/local/cuda/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH}"
# Make RUN commands use the new environment:
SHELL ["conda", "run", "-n", "pytorch", "/bin/bash", "-c"]

# --- Dependency Installation ---
# Install conda packages. A single command allows the solver to find a compatible set of dependencies.
# torch2.0.1+cuda11.8 is recommended, as cuda11.8 is compatible with RTX 4090.
# Newer torch versions (e.g., 2.1+cuda12.1) can cause errors with torch-ngp.
RUN conda install -c pytorch -c nvidia -c conda-forge -y \
    'pytorch=2.0.1=py3.9_cuda11.8_cudnn8.7.0_0' \
    'torchvision=0.15.2' \
    'torchaudio=2.0.2' \
    'pytorch-cuda=11.8' \
    'ffmpeg' \
    'gxx_linux-64' \
    'cmake' \
    'dlib' \
    'pyaudio'

# --- CUDA Environment Configuration ---
# Set CUDA_HOME to the conda environment's path to ensure that C++ extension builds
# (like torch-ngp) use the conda-installed CUDA toolkit (11.8) instead of the
# system-level one, resolving potential mismatch errors.
ENV CUDA_HOME="/root/miniconda3/envs/pytorch"

# --- Pip Configuration & Installation ---
# Trust specific hosts to avoid SSL issues and install pip packages in a single layer.
ENV PIP_TRUSTED_HOST="download.openmmlab.com pypi.org files.pythonhosted.org"
RUN pip install \
    "git+https://github.com/facebookresearch/pytorch3d.git@stable" \
    chardet \
    cython \
    "openmim==0.3.9" && \
    mim install "mmcv==2.1.0"

# Install system-level dependencies required for some python packages.
RUN apt-get update -y && \
    apt-get install -y libasound2-dev portaudio19-dev libgl1 && \
    rm -rf /var/lib/apt/lists/*

# Copy application code and set working directory
COPY . /workspace
WORKDIR /workspace

# Install python dependencies from requirements.txt
RUN pip install -r docs/prepare_env/requirements.txt -v

# install torch-ngp extension
RUN bash docs/prepare_env/install_ext.sh
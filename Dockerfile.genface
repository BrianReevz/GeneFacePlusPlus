# Start with your base image
FROM ubuntu22.04-cu118-conda:torch2.0.1-py39

# Enable BuildKit inline cache
ARG BUILDKIT_INLINE_CACHE=1 

# ================== THIS IS THE FIX ==================
#
# DELETE this line. It is breaking the build environment.
# SHELL ["conda", "run", "-n", "pytorch", "/bin/bash", "-c"]
#
# ADD this line instead to correctly activate the environment.
# Note: The conda path in this base image might be /opt/conda/.
ENV PATH /opt/conda/envs/pytorch/bin:$PATH
#
# ======================================================
# 1. Create a NEW conda environment with a specific Python version (e.g., 3.10)
#    This isolates your build from the base image's pinned Python 3.13.
RUN conda create -n genface_env python=3.10 -y

# 2. Activate the new environment for all future commands.
ENV PATH /opt/conda/envs/genface_env/bin:$PATH
RUN conda install conda-forge::ffmpeg # ffmpeg with libx264 codec to turn images to video

# Install PyTorch with exact CUDA 11.8 version to match system CUDA
RUN conda install -n genface_env pytorch==2.0.1 torchvision==0.15.2 torchaudio==2.0.2 pytorch-cuda=11.8 -c pytorch -c nvidia -y && \
    echo "PyTorch installed with CUDA 11.8"

# install mmcv by mim
RUN pip install "git+https://github.com/facebookresearch/pytorch3d.git@stable" && \
    pip install chardet cython openmim==0.3.9 && \
    mim install mmcv==2.1.0 

COPY . /workspace
WORKDIR /workspace

# These commands will now run in a unified environment and succeed
#RUN apt update -y && apt-get install -y libasound2-dev portaudio19-dev libgl1 && \
#    pip install -r docs/prepare_env/requirements.txt -v
# First, install comprehensive build dependencies for dlib and other packages
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends \
    # Core build tools
    build-essential cmake pkg-config \
    # Dlib C++ dependencies
    libx11-dev libatlas-base-dev libgtk-3-dev libboost-python-dev \
    libasound2-dev portaudio19-dev libgl1 \
    libopenblas-dev liblapack-dev \
    libjpeg-dev libpng-dev \
    libavcodec-dev libavformat-dev libswscale-dev \
    libgstreamer-plugins-base1.0-dev && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install cmake via pip to ensure Python can find it
RUN pip install cmake && \
    echo "Pip CMake installed successfully"

# Second, install Python packages (excluding dlib for now)
RUN pip install -r docs/prepare_env/requirements.txt -v || \
    (echo "Some packages failed, trying without dlib..." && \
     grep -v "dlib" docs/prepare_env/requirements.txt | pip install -r /dev/stdin -v)

# Install dlib with explicit cmake path and compiler optimization
RUN python3 -c 'import cmake; print(f"Using cmake from: {cmake.CMAKE_BIN_DIR}")' && \
    export CMAKE_BIN_DIR=$(python3 -c 'import cmake; print(cmake.CMAKE_BIN_DIR)') && \
    export PATH="$CMAKE_BIN_DIR:$PATH" && \
    echo "Updated PATH with cmake: $PATH" && \
    pip install dlib --no-cache-dir --verbose || \
    (echo "Trying dlib with specific compiler flags..." && \
     export CFLAGS="-O3" && \
     export CXXFLAGS="-O3" && \
     pip install dlib --no-cache-dir --verbose) || \
    (echo "Trying dlib with explicit cmake path..." && \
     export CMAKE_BIN_DIR=$(python3 -c 'import cmake; print(cmake.CMAKE_BIN_DIR)') && \
     export PATH="$CMAKE_BIN_DIR:$PATH" && \
     export CFLAGS="-O3" && \
     export CXXFLAGS="-O3" && \
     pip install dlib --no-cache-dir --verbose)

# Set CUDA environment variables for torch-ngp extension compilation
ENV CUDA_HOME=/usr/local/cuda
ENV CUDA_ROOT=/usr/local/cuda
ENV PATH=/usr/local/cuda/bin:$PATH
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH

# Verify CUDA and PyTorch versions match
RUN python3 -c "import torch; print(f'PyTorch CUDA version: {torch.version.cuda}'); print(f'CUDA available: {torch.cuda.is_available()}'); print(f'CUDA device count: {torch.cuda.device_count()}')"

# install torch-ngp extension with proper CUDA environment
RUN bash docs/prepare_env/install_ext.sh
# Start with your base image
FROM ubuntu22.04-cu118-conda:torch2.0.1-py39

# Enable BuildKit inline cache
ARG BUILDKIT_INLINE_CACHE=1 

# Set build optimizations for faster C++ compilation
ENV MAKEFLAGS="-j$(nproc)"
ENV CMAKE_BUILD_PARALLEL_LEVEL="$(nproc)"
ENV DEBIAN_FRONTEND="noninteractive"
# Additional optimizations for torch extensions
ENV TORCH_CUDA_ARCH_LIST="6.0;6.1;7.0;7.5;8.0;8.6"
ENV FORCE_CUDA="1"
ENV MAX_JOBS="$(nproc)"

# ================== THIS IS THE FIX ==================
#
# DELETE this line. It is breaking the build environment.
# SHELL ["conda", "run", "-n", "pytorch", "/bin/bash", "-c"]
#
# ADD this line instead to correctly activate the environment.
# Note: The conda path in this base image is /root/miniconda3/.
ENV PATH /root/miniconda3/envs/pytorch/bin:$PATH
#
# ======================================================
# 1. Create a NEW conda environment with a specific Python version (e.g., 3.10)
#    This isolates your build from the base image's pinned Python 3.13.
RUN conda create -n genface_env python=3.10 -y

# 2. Activate the new environment for all future commands.
ENV PATH /root/miniconda3/envs/genface_env/bin:$PATH
RUN conda install conda-forge::ffmpeg # ffmpeg with libx264 codec to turn images to video

# Install PyTorch with exact CUDA 11.8 version to match system CUDA
RUN conda install -n genface_env pytorch==2.0.1 torchvision==0.15.2 torchaudio==2.0.2 pytorch-cuda=11.8 -c pytorch -c nvidia -y && \
    echo "PyTorch installed with CUDA 11.8"

# install mmcv by mim
RUN /root/miniconda3/envs/genface_env/bin/pip install "git+https://github.com/facebookresearch/pytorch3d.git@stable" && \
    /root/miniconda3/envs/genface_env/bin/pip install chardet cython openmim==0.3.9 && \
    /root/miniconda3/envs/genface_env/bin/pip install mmcv==2.1.0 

COPY . /workspace
WORKDIR /workspace

# First, install comprehensive build dependencies for dlib and other packages
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends \
    # Core build tools
    build-essential cmake pkg-config \
    # Dlib C++ dependencies
    libx11-dev libatlas-base-dev libgtk-3-dev libboost-python-dev \
    libasound2-dev portaudio19-dev libgl1 \
    libopenblas-dev liblapack-dev \
    libjpeg-dev libpng-dev \
    libavcodec-dev libavformat-dev libswscale-dev \
    libgstreamer-plugins-base1.0-dev && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install cmake via pip in the pytorch environment to ensure dlib can find it
RUN /root/miniconda3/envs/pytorch/bin/python -m pip install cmake && \
    echo "Pip CMake installed in pytorch environment successfully"

# Set CUDA environment variables for torch-ngp extension compilation
ENV CUDA_HOME=/usr/local/cuda
ENV CUDA_ROOT=/usr/local/cuda
ENV PATH=/usr/local/cuda/bin:$PATH
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH

# Try to install pre-built dlib first (much faster than compilation)
RUN /root/miniconda3/envs/genface_env/bin/pip install --only-binary=all dlib || \
    (echo "Pre-built dlib not available, will compile from source..." && \
     /root/miniconda3/envs/genface_env/bin/pip install dlib --no-cache-dir --verbose)

# Install remaining Python packages, excluding dlib if it was already installed
RUN /root/miniconda3/envs/genface_env/bin/pip install -r docs/prepare_env/requirements.txt -v || \
    (echo 'Some packages failed, trying without dlib...' && \
     grep -v 'dlib' docs/prepare_env/requirements.txt | /root/miniconda3/envs/genface_env/bin/pip install -r /dev/stdin -v)

# Verify dlib installation in genface environment
RUN /root/miniconda3/envs/genface_env/bin/python -c "import dlib; print('dlib installed successfully in genface environment')"

# Verify CUDA and PyTorch versions match
RUN /root/miniconda3/envs/genface_env/bin/python -c "import torch; print(f'PyTorch CUDA version: {torch.version.cuda}'); print(f'CUDA available: {torch.cuda.is_available()}'); print(f'CUDA device count: {torch.cuda.device_count()}')"

# install torch-ngp extension with proper CUDA environment
RUN /root/miniconda3/envs/genface_env/bin/bash docs/prepare_env/install_ext.sh
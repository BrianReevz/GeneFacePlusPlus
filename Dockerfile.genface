
ARG BASE_IMAGE
#FROM ubuntu22.04-cu118-conda:torch2.0.1-py39 
FROM ${BASE_IMAGE}

# Set environment variables to ensure the CUDA toolkit is found by compilers.
# This is crucial for building Python packages with C++/CUDA extensions.
ENV PATH="/usr/local/cuda/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH}"
# Make RUN commands use the new environment:
SHELL ["conda", "run", "-n", "pytorch", "/bin/bash", "-c"]

RUN conda install conda-forge::ffmpeg # ffmpeg with libx264 codec to turn images to video

# Install a C++ compiler and cmake directly into the conda environment.
# This is the most reliable way to ensure tools like pip can find them
# when they need to build packages from source (like dlib), as it avoids
# PATH issues caused by conda's activation scripts.
RUN conda install -c conda-forge gxx_linux-64 cmake

# torch2.0.1+cuda11.8 is recommended , cuda11.8 is compatible with RTX 4090.
# And torch=2.1+cuda12.1 will cause error of torch-ngp 
RUN conda install pytorch==2.0.1 torchvision==0.15.2 torchaudio==2.0.2 pytorch-cuda=11.8 -c pytorch -c nvidia

# install mmcv by mim
RUN pip install "git+https://github.com/facebookresearch/pytorch3d.git@stable" && \
    pip install chardet cython openmim==0.3.9 && \ 
    mim install mmcv==2.1.0 

COPY . /workspace
WORKDIR /workspace


# other dependencies
RUN apt update -y && apt-get install -y libasound2-dev portaudio19-dev libgl1

# Install a C++ compiler directly into the conda environment. This ensures that
# pip can find it when it needs to build packages like dlib from source,
# avoiding PATH issues caused by the conda activation.
RUN conda install -c conda-forge gxx_linux-64

RUN pip install -r docs/prepare_env/requirements.txt -v


# install torch-ngp extension
RUN bash docs/prepare_env/install_ext.sh
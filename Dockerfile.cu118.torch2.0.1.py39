# ARG declarations at the top are great
ARG CUDA_VERSION="11.8.0"
ARG CUDNN_VERSION="8"
ARG UBUNTU_VERSION="22.04"

# Base NVidia CUDA Ubuntu image
FROM nvidia/cuda:$CUDA_VERSION-cudnn$CUDNN_VERSION-devel-ubuntu$UBUNTU_VERSION AS base

# Set up environment variables
ENV HOME /root
WORKDIR $HOME
ENV PYTHON_VERSION=3.9.18
ENV PATH="/usr/local/cuda/bin:${PATH}"

# == STEP 1: Install all system dependencies ==
# == STEP 1: Install all system dependencies ==
# This layer changes infrequently. It installs OS packages and build tools.
# It now includes the C++ dev libraries required by dlib. ✅
ARG APTPKGS="zsh wget tmux tldr nvtop vim neovim curl rsync net-tools less iputils-ping 7zip zip unzip"
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends \
    # Core build tools
    cmake \
    build-essential \
    libssl-dev \
    libffi-dev \
    # Python and Git
    python3 python3-pip python3-venv \
    openssh-server openssh-client git git-lfs \
    # Dlib C++ dependencies
    libx11-dev \
    libjpeg-dev \
    libpng-dev \
    # Utility packages
    $APTPKGS && \
    # Clean up to reduce image size
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# == STEP 2: Install and configure Conda Environment ==
# This layer also changes infrequently. It creates your core PyTorch environment.
ENV PATH="/root/miniconda3/bin:${PATH}"
RUN wget https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh \
    && bash Miniconda3-latest-Linux-x86_64.sh -b -p /root/miniconda3 \
    && rm -f Miniconda3-latest-Linux-x86_64.sh \
    && conda init bash \
    && conda tos accept --override-channels --channel defaults \
    && conda update -n base conda -y

ENV CONDA_ENV_NAME=pytorch
RUN conda create -n ${CONDA_ENV_NAME} python=3.9 \
    pytorch==2.0.1 \
    pytorch-cuda=11.8 \
    -c pytorch -c nvidia -y \
    && conda install -n ${CONDA_ENV_NAME} intel-openmp=2023 -y

# Activate the Conda environment for all subsequent commands
ENV PATH="/root/miniconda3/envs/${CONDA_ENV_NAME}/bin:${PATH}"

# == STEP 3: Install Python dependencies ==
# This layer changes more often. By copying only requirements.txt, Docker can
# reuse the cache from steps 1 & 2 if only Python packages change.
COPY requirements.txt .
RUN pip install -r requirements.txt

# == STEP 4: Copy your application code ==
# This is the most frequently changed layer, so it comes last.
# COPY . /workspace/

# Final configuration
WORKDIR /workspace
RUN git config --global credential.helper store && git lfs install
CMD [ "tail", "-f", "/dev/null" ]